        "flags": {"dark": True, "indoors": True},
        "sector": 'inside',
    },
    3450: {
        "name": 'Entrance to the Forbidden Catacombs',
        "desc": 'You have entered the forbidden catacombs.  This cave system must have been\nbuilt long ago.  The air is dank and smells of something dead ...  or maybe\nundead.  Enter here at your own risk ... something evil abides.',
        "exits": {
            "n": {"to": 3451, "desc": 'Too dark to tell.'},
            "e": {"to": 3452, "desc": 'Too dark to tell.'},
            "s": {"to": 3453, "desc": 'Too dark to tell.'},
            "w": {"to": 3454, "desc": 'Too dark to tell.'},
            "u": 3408,
        },
        "flags": {"dark": True, "indoors": True},
        "sector": 'inside',
    },
    3451: {
        "name": 'The Catacombs',
        "desc": 'Stone walls, musty air ... the earth seems to moan softly.',
        "exits": {

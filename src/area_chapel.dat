    },
    3437: {
        "name": 'The Grand Hall of Kings',
        "desc": 'You are at the western end of the Grand Hall of Kings.  There is a\ndoor leading north and the hallway continues west.',
        "exits": {
            "n": {"to": 3409, "keyword": 'door', "isdoor": True, "closed": True},
            "w": 3432,
        },
        "flags": {"dark": True, "indoors": True},
        "sector": 'inside',
    },
    3438: {
        "name": 'The Shrine of Jubal',
        "desc": 'This was once beautiful.  Now the huge tapestries have been torn down and the\ncarpeting pulled up ... the paintings on the ceiling are unreadable and the\naltar is crumbled.',
        "exits": {
            "s": 3439,
            "w": 3433,
        },
        "flags": {"dark": True, "indoors": True},
        "sector": 'inside',
    },
    3439: {
        "name": 'The Tomb of Jubal',
        "desc": 'The smell coming off of the opened sarcophagus is nauseating.  The floor is\nslightly crumpled and walls are raked ... but the worst part is the mummy ...\nJubal the Benevolent is missing his head!',
        "exits": {
            "n": 3438,
            "u": 3434,
        },
        "flags": {"dark": True, "indoors": True},
        "sector": 'inside',
    },

    3448: {
        "name": 'The Lower Chambers and Tombs of the Undead',
        "desc": 'This room has been totally hollowed out and smoothed, and a pit has been\ndrilled in the center of the floor.  There are extensive gruesome paintings\nof beasts and monsters terrorizing the countryside; vampires sucking the\nblood of beasts and humans alike.',
        "exits": {
            "n": 3447,
        },
        "flags": {"dark": True, "indoors": True, "no_recall": True},
        "sector": 'inside',
        "extra_descs": [('painting paintings mural', "There is a tiny painting of a vault in this mural ... and it seems to be a\nreflected picture of the vault ... the word in tiny print is 'rathcor'.")],
    },
    3449: {
        "name": 'The Lower Chambers and Tombs of the Undead',
        "desc": 'The stench of death is heavy in these caverns.',
        "exits": {
            "e": {"to": 3408, "keyword": 'door', "isdoor": True, "closed": True, "locked": True, "pickproof": True, "key": 3411},
            "w": 3444,

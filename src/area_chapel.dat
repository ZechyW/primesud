    3460: {
        "name": 'Den of the Vampire',
        "desc": 'Your mind whirls in the hideous madness of this place.  The stench\nis horrendous and dead bodies, sucked of life, lay all over.  One coffin\nlies in the center of the room ... waiting for YOU!',
        "exits": {
            "e": {"to": 3459, "desc": 'Too dark to tell.'},
            "d": {"to": 3475, "desc": 'A jet black coffin ... who knows what lurks beneath.', "keyword": 'coffin', "isdoor": True, "closed": True, "locked": True, "pickproof": True, "key": 3419},
        },
        "flags": {"dark": True, "indoors": True},
        "sector": 'inside',
    },

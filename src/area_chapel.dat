            "w": {"to": 3463, "desc": 'Too dark to tell.'},
        },
        "flags": {"dark": True, "indoors": True, "no_recall": True},
        "sector": 'inside',
    },
    3465: {
        "name": 'The Gilded Hallway',
        "desc": "Wow!  Although this hallway is quite filthy and dusty, it is noticeably\ndifferent than the rest of the catacombs ... but you don't feel safe yet.\nThe walls faintly show ancient detailed etchings in gold and silver of\nancient rituals ... not all of which seem pleasant.  The hallway continues\nnorth into the catacombs and further south as long as you can see.",
        "exits": {
            "n": {"to": 3464, "desc": 'The glow of your light reflects off the walls and you see the catacombs.'},
            "s": {"to": 3466, "desc": 'The glow of your light reflects off the walls ... the gilded hallway.'},

# One line-ending representation everywhere. The worktree is shared between a
# Windows host and a Linux container, so eol=lf (which overrides core.autocrlf
# on every platform) keeps both sides seeing identical bytes.
* text=auto eol=lf

# Generated data files: byte-exact on device (help.idx stores byte offsets
# into help.txt). Never let git eol-normalize these. Listed after the wildcard
# above: for each attribute, the last matching pattern wins.
src/area_*.txt -text
src/help.txt -text
src/socials.txt -text
src/music.txt -text
src/commands.txt -text
*.idx -text
*.bin -text

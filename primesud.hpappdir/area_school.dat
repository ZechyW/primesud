    3757: {
        "name": 'A Room in Mud School',
        "desc": "You are in a room in Mud School.  Paintings of the heroic graduates of mud\nschool adorn the walls. To the west is Furey's Training Room, and to the east\nis Zump's Guild Room.  North of you is the next Station of Mud School.\nThere is a sign on the wall (type 'LOOK SIGN' to read it).",
        "exits": {
            "n": {"to": 3701, "desc": 'You see the next station of Mud School.'},
            "e": {"to": 3759, "desc": "You see Zump's Guild Room.  Go there to practice your skills."},
            "s": {"to": 3700, "desc": 'You see the entrance to Mud School.'},
            "w": {"to": 3758, "desc": "You see Furey's Training Room.  Go there to train your attributes."},
        },
        "flags": {"no_mob": True, "indoors": True, "newbies_only": True},
        "sector": 'city',
        "extra_descs": [('sign', "To find out your attributes, type 'score'.  You can improve your attributes\nin Furey's Training Room to the west.  You can practice your skills and spells\nin Zump's Guild Room to the east.  You can continue through mud school by\ngoing north.\n\nIf you are a new character, you should go 'WEST' from here, train your\nabilities, and then come back here and go 'NORTH'.")],
    },
    3758: {
        "name": "Furey's Training Room",
        "desc": "You are in Furey's Training Room.  Around you are all sorts of physical\nand mental training tools.  The whole room is filled with magic, holiness,\nand sweat.  There is a sign on the wall.",
        "exits": {
            "e": {"to": 3757, "desc": 'You see the room you came from, and the room you should go to.'},
        },
        "flags": {"no_mob": True, "indoors": True, "newbies_only": True},
        "sector": 'city',
        "extra_descs": [('sign', "Welcome to Furey's Training Room.  Here you can train your attributes.  To\ntrain an attribute, you need enough practices.  To find out how many practice\nsessions you have, type 'train' while you are in this room.  To train for a\nspecific attribute, type 'train <attr>' where attr is the first 3 letters of\nthe attribute you want increased.  Type 'help train' for more information.")],
    },
    3759: {
        "name": "Zump's Guild Room",
        "desc": 'You are in a room filled with weapons, books, and many combat dummies, some\ncut and stabbed many times, others burnt to a crisp.  The room is filled with\nsweat and an aura of magic.  There is a sign on the wall.',
        "exits": {
            "w": {"to": 3757, "desc": 'You see the room you came from and the room you should go to.'},
        },
        "flags": {"no_mob": True, "indoors": True, "newbies_only": True},
        "sector": 'city',
        "extra_descs": [('sign', "Welcome to Zump's Guild Room.  Here you will learn your skills and spells.\nTo find out what skills and spells you can practice and how many practice\nsessions you have, type 'practice'.  To practice the specific skill, type\n'practice <skill>', where 'skill' is the skill or spell you wish to practice.\nPracticing increases the amount you know of that skill or spell, up to a\ncertain maximum.  When you have practiced all you wish to practice, go west.")],
    },
    3760: {
        "name": 'A Safe Room',
        "desc": 'You are in a safe room, away from all the mean rabbits and snails of the Arena.\nYou can rest here, and go up to go back to the Temple of Midgaard.',
        "exits": {
            "u": {"to": 3001, "desc": 'You see the Temple of Midgaard.'},
        },
        "flags": {"no_mob": True, "indoors": True},
        "sector": 'inside',
    },
}


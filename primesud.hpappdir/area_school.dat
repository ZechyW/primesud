            "e": 3735,
            "s": 3729,
            "w": 3733,
            "u": {"to": 3760, "desc": 'You see the EXIT.'},
            "d": {"to": 3748, "desc": 'You see a dark murky dungeon below.', "keyword": 'grate', "isdoor": True, "closed": True},
        },
        "flags": {"indoors": True},
        "sector": 'inside',
        "extra_descs": [('sign', 'Those with high bravery or low senses of cautiousness might wish to go below\nto the Dungeon.  However, know that there are aggressive monsters down there,\nand there is no quick escape back out of here when you are in the dungeon.')],
    },
